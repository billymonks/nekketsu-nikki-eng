# Large disc files (not tracked in git)
/extracted-disc/*
/extracted-english-disc/*
/english-disc/*
/original-disc/*
/translated-disc/*
/extracted-afs/*
/extracted-english-afs/*
/modified-disc-files/*
/modified-afs-contents/*

/textures/*

# Tools are downloaded separately (mgrepack is distributed with the project)
/tools/*
!/tools/mgrepack/
/tools/mgrepack/extract/
/tools/mgrepack/replacement/

# Extracted and modified images (large binary files)
/extracted-images/*
/modified-images/*

# Keep directory structure
!/**/.gitkeep
